{
  "name": "@celestia-island/lagrange-webui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "vue-tsc --noEmit --pretty false 2>&1 | grep -v node_modules || true",
    "test": "vitest run",
    "build:ssr": "vite build --ssr scripts/ssr-render.mjs --outDir dist/ssr --emptyOutDir && node dist/ssr/ssr-render.js",
    "build:docs": "vite build --mode docs-client",
    "build:docs:ssr": "vite build --mode docs-ssr",
    "build:docs:all": "pnpm build:docs && pnpm build:docs:ssr"
  },
  "dependencies": {
    "@celestia-island/hikari": "^0.55.483",
    "@vue/server-renderer": "^3.5.45",
    "dompurify": "^3.4.18",
    "lucide-vue-next": "^1",
    "marked": "^18.2.1",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6",
    "@vitejs/plugin-vue-jsx": "^5",
    "happy-dom": "^20",
    "sass-embedded": "^1.108.2",
    "typescript": "~6.0",
    "vite": "^8.2",
    "vitest": "^3",
    "vue-tsc": "^3.3"
  }
}
